{
  "id": "classic",
  "name": "经典极简",
  "version": "1.0.0",
  "entryCss": "style.css",
  "description": "纯黑白、依靠字体层级和横线建立结构，没有装饰性元素，最接近经典纸质简历。",
  "schemaPreset": "standard",
  "defaults": {
    "themeColor": "#000000",
    "fontFamily": "\"Microsoft YaHei\", \"PingFang SC\", sans-serif",
    "fontSize": 13,
    "paragraphSpacing": 5,
    "h2MarginTop": 8,
    "h2MarginBottom": 4,
    "h3MarginTop": 5,
    "h3MarginBottom": 3,
    "personalHeaderSpacing": 2,
    "h1Size": 26,
    "h2Size": 16,
    "h3Size": 14,
    "dateSize": 13,
    "dateWeight": "400",
    "lineHeight": 1.3,
    "marginV": 10,
    "marginH": 12,
    "personalInfoMode": "text",
    "headerLayout": "stack",
    "photoPlacement": "top-right",
    "sectionTitlePreset": "underline"
  },
  "features": {
    "photo": true,
    "pageFooter": true,
    "contactModes": ["text", "icon"]
  },
  "layout": {
    "headerLayout": "stack",
    "personalInfoMode": "text",
    "photoPlacement": "top-right",
    "sectionTitlePreset": "underline"
  }
}
