{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "../..",
    "paths": {
      "@max-md2cv/*": ["packages/*/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "../../packages/resume-core/src/domain.ts",
    "../../packages/resume-core/src/types/**/*.ts",
    "../../packages/resume-core/src/utils/**/*.ts",
    "../../packages/resume-renderer/src/**/*.ts"
  ]
}
